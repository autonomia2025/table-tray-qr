# Copia este archivo como .env y completa con los datos del proyecto de Supabase.
# En Vercel, estas variables están configuradas en el proyecto (no se suben al repositorio).
VITE_SUPABASE_PROJECT_ID="<id del proyecto>"
VITE_SUPABASE_URL="https://<id del proyecto>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<clave pública (anon)>"
